# Production build config for the React client (Create React App).
#
# REACT_APP_API_URL points the built bundle at the deployed Express API on
# Render. It is inlined into the JavaScript at build time — it MUST be a public
# URL and MUST NEVER contain secrets. Render's blueprint / Vercel can also set
# this variable in the dashboard; committing it here means a plain
# `npm run build` still targets the correct backend even with no env var set.
REACT_APP_API_URL=https://hirepilot-jber.onrender.com

# Mirrors the dev client .env so production builds lint the same way.
DISABLE_ESLINT_PLUGIN=true
