# =============================================================================
# HirePilot environment variables  (copy to .env at the repo root)
# -----------------------------------------------------------------------------
# ENV SPLIT (production):
#   Render (API  : https://hirepilot-jber.onrender.com)  -> EVERYTHING BELOW
#     including ALL secrets (JWT_SECRET, ENCRYPTION_KEY, MONGO_URI, LLM keys).
#     Render reads dashboard env vars (see render.yaml), not this file.
#   Vercel (web  : https://hire-pilot-job.vercel.app)    -> only ONE variable:
#     REACT_APP_API_URL=https://hirepilot-jber.onrender.com  (public by design;
#     set in client/.env.production, already committed).
# Secrets are backend-only — never prefix them with REACT_APP_ (that would
# bake them into the public JS bundle).
# Health probes: GET /api/health/live  (liveness), GET /api/health/ready
# (DB readiness), GET /api/health (combined, Render healthCheckPath).
# Full route contract: ENDPOINTS.md
# =============================================================================

# ---- Required in production -------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
# MongoDB Atlas free tier connection string (production only; dev uses embedded Mongo)
MONGO_URI=

# ---- Optional LLM provider keys (absent key = provider skipped, never a crash)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ---- Optional job-source keys (feature-flagged, off unless key is set) -------
ADZUNA_CLIENT_ID=
ADZUNA_API_KEY=
JSEARCH_API_KEY=

# ---- LLM model ids / router tuning ------------------------------------------
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_LARGE_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,google/gemini-2.0-flash-exp:free
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=45000
LLM_BUDGET_PER_MIN=30

# ---- Pipeline ---------------------------------------------------------------
APPLY_CONCURRENCY=4
DEFAULT_BATCH_SIZE=25
MAX_BATCH_SIZE=100
FIT_GATE_THRESHOLD=70

# ---- Feature flags ----------------------------------------------------------
FLAG_AUTO_SUBMIT=false
FLAG_LLM_ENRICHMENT=true
# Background job-cache warm-up on boot: off by default (it spends API quota)
FLAG_WARM_CACHE_ON_BOOT=false
FLAG_SOURCE_REMOTIVE=true
FLAG_SOURCE_HIMALAYAS=true
FLAG_SOURCE_JOBICY=true
FLAG_SOURCE_REMOTEOK=true
FLAG_SOURCE_ARBEITNOW=true
FLAG_SOURCE_WWR=true
FLAG_SOURCE_GREENHOUSE=true
FLAG_SOURCE_LEVER=true
FLAG_SOURCE_ASHBY=true
FLAG_SOURCE_ADZUNA=false
FLAG_SOURCE_USAJOB=false
FLAG_SOURCE_JSEARCH=false

# ---- Ops --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://hire-pilot-job.vercel.app
MONGO_MEMORY_EPHEMERAL=false
METRICS_TOKEN=
SENTRY_DSN=

# ---- How to run -------------------------------------------------------------
#   cd server && npm install
#   npm run smoke      # offline module + PDF/DOCX round-trip checks
#   npm run db:check   # verify the embedded dev database starts
#   npm run dev        # start the API (embedded Mongo, no setup)
#   npm test           # jest suite against an in-memory Mongo
#
# Every provider above has a free tier; with no LLM key set the app still works
# in deterministic local-only mode.

